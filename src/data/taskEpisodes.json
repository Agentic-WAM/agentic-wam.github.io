 {
  "id": "arrange_fruits",
  "label": "Arrange Fruits",
  "platform": "yam",
  "instruction": "Arrange the fruits so that finally there are only banana and cucumber in the left bowl.",
  "fps": 30,
  "video": "/videos/episodes/arrange_fruits.mp4",
  "figure": "/figures/tasks/arrange_fruits.webp",
  "blocks": [
   [
    {
     "text": "for item in robot.scan('left bowl'):",
     "executed": true
    },
    {
     "text": "    if item not in ('banana', 'cucumber'):",
     "executed": true
    },
    {
     "text": "        # intruder: move it out of the left bowl to the right side",
     "executed": true
    }
   ],
   [
    {
     "text": "        approach_best_grasp(robot, item, 'either', [0.0, 0.0, -0.05])",
     "executed": true
    },
    {
     "text": "        robot.close_gripper('auto')",
     "executed": true
    },
    {
     "text": "        relocate_object(robot, item, 'right side')",
     "executed": true
    },
    {
     "text": "        robot.open_gripper('auto')",
     "executed": true
    }
   ],
   [
    {
     "text": "if 'banana' not in robot.scan('left bowl'):",
     "executed": true
    },
    {
     "text": "    # bring the banana in from the right",
     "executed": true
    },
    {
     "text": "    approach_best_grasp(robot, 'banana', 'either', [0.0, 0.0, -0.05])",
     "executed": true
    },
    {
     "text": "    robot.close_gripper('auto')",
     "executed": true
    },
    {
     "text": "    lower_onto_target(robot, 'banana', 'left bowl')",
     "executed": true
    },
    {
     "text": "    robot.open_gripper('auto')",
     "executed": true
    }
   ],
   [
    {
     "text": "if 'cucumber' not in robot.scan('left bowl'):",
     "executed": true
    },
    {
     "text": "    # bring the cucumber in from the right",
     "executed": true
    },
    {
     "text": "    approach_best_grasp(robot, 'cucumber', 'either', [0.0, 0.0, -0.05])",
     "executed": true
    },
    {
     "text": "    robot.close_gripper('auto')",
     "executed": true
    },
    {
     "text": "    lower_onto_target(robot, 'cucumber', 'left bowl')",
     "executed": true
    },
    {
     "text": "    robot.open_gripper('auto')",
     "executed": true
    }
   ]
  ],
