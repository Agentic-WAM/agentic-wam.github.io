 {
  "id": "replace_lightbulb",
  "label": "Replace Lightbulb",
  "platform": "yam",
  "instruction": "Change the lightbulb if it doesn't work.",
  "fps": 30,
  "video": "/videos/episodes/replace_lightbulb.mp4",
  "figure": "/figures/tasks/replace_lightbulb.webp",
  "blocks": [
   [
    {
     "text": "# Change the lightbulb if it doesn't work.",
     "executed": true
    },
    {
     "text": "# STAGE 1 -- TEST: the LEFT arm presses the wall switch; watch the bulb.",
     "executed": true
    },
    {
     "text": "robot.press('light switch', 'left')",
     "executed": true
    },
    {
     "text": "if robot.observe('bulb') == 'lit':",
     "executed": true
    },
    {
     "text": "    robot.go_home()                      # the bulb works; nothing to change",
     "executed": false
    },
    {
     "text": "else:",
     "executed": true
    },
    {
     "text": "    # The bulb stayed DARK -- it is broken. Replace it; the switch stays ON,",
     "executed": true
    },
    {
     "text": "    # so the lamp will light by itself once a working bulb is seated.",
     "executed": true
    },
    {
     "text": "    # The LEFT arm braces the lamp base the whole time the right arm works:",
     "executed": true
    }
   ],
   [
    {
     "text": "    robot.grasp('lamp base', 'left')",
     "executed": true
    }
   ],
   [
    {
     "text": "    # STAGE 2 -- UNSCREW the broken bulb (counter-clockwise), two ratchet bites per call:",
     "executed": true
    },
    {
     "text": "    while not robot.is_free('old bulb'):",
     "executed": true
    },
    {
     "text": "        ratchet_twist_off(robot, 'old bulb', 'right', turn_deg=-60)   # UNSCREWING",
     "executed": true
    },
    {
     "text": "    pull_part_free(robot, 'old bulb', 'right')       # lift it clear of the socket",
     "executed": true
    }
   ],
   [
    {
     "text": "    # STAGE 3 -- DISCARD: carry the broken bulb to the bulb tray and set it down.",
     "executed": true
    },
    {
     "text": "    relocate_object(robot, 'old bulb', 'bulb tray')",
     "executed": true
    }
   ],
   [
    {
     "text": "    # STAGE 4 -- FETCH the NEW bulb: open the idle hand, pick it up.",
     "executed": true
    },
    {
     "text": "    free_hand_and_pick(robot, 'new bulb', 'right')",
     "executed": true
    }
   ],
   [
    {
     "text": "    # STAGE 5 -- SEAT and SCREW IN the new bulb (clockwise), two strokes per call:",
     "executed": true
    },
    {
     "text": "    lower_onto_target(robot, 'new bulb', 'socket')",
     "executed": true
    },
    {
     "text": "    while not robot.is_seated('new bulb'):",
     "executed": true
    },
    {
     "text": "        ratchet_turn_fastener(robot, 'new bulb', 'right', turn_deg=+60)  # SCREWING IN",
     "executed": true
    }
   ],
   [
    {
     "text": "    robot.release('left')                # let go of the lamp base",
     "executed": true
    },
    {
     "text": "    # the lamp LIGHTS -- the switch was on the whole time. Task done.",
     "executed": true
    }
   ]
  ],
  "segments": [
