 {
  "id": "pack_backpack",
  "label": "Pack Backpack",
  "platform": "yam",
  "instruction": "Pack the backpack.",
  "fps": 30,
  "video": "/videos/episodes/pack_backpack.mp4",
  "figure": "/figures/tasks/pack_backpack.webp",
  "blocks": [
   [
    {
     "text": "# STAGE 1/5 -- OPENING, left arm: grasp the zipper pull at the LEFT end.",
     "executed": true
    },
    {
     "text": "# Lift the pull UP first so it does not snag, then slide it LEFT -> MIDDLE.",
     "executed": true
    },
    {
     "text": "approach_best_grasp(robot, 'zipper pull', 'left', [0.0, 0.0, 0.05])",
     "executed": true
    },
    {
     "text": "robot.close_gripper('left')",
     "executed": true
    },
    {
     "text": "run_zipper_along_seam(robot, 'left', 'left end', 'middle')  # OPENING, first half",
     "executed": true
    },
    {
     "text": "robot.open_gripper('left')",
     "executed": true
    }
   ],
   [
    {
     "text": "# STAGE 2/5 -- OPENING, right arm: grasp the pull at the MIDDLE of the seam.",
     "executed": true
    },
    {
     "text": "# Lift UP, then slide MIDDLE -> RIGHT; after this the backpack is fully OPEN.",
     "executed": true
    },
    {
     "text": "approach_best_grasp(robot, 'zipper pull', 'right', [0.0, 0.0, 0.05])",
     "executed": true
    },
    {
     "text": "robot.close_gripper('right')",
     "executed": true
    },
    {
     "text": "run_zipper_along_seam(robot, 'right', 'middle', 'right end')  # OPENING, second half",
     "executed": true
    },
    {
     "text": "robot.open_gripper('right')",
     "executed": true
    }
   ],
   [
    {
     "text": "# STAGE 3/5 -- PACK: the backpack is OPEN; put each item in.",
     "executed": true
    },
    {
     "text": "approach_best_grasp(robot, item, 'either', [0.0, 0.0, -0.05])",
     "executed": true
    },
    {
     "text": "robot.close_gripper('auto')",
     "executed": true
    },
    {
     "text": "lower_onto_target(robot, item, 'open backpack')",
     "executed": true
    },
    {
     "text": "robot.open_gripper('auto')",
     "executed": true
    }
   ],
   [
    {
     "text": "# STAGE 4/5 -- CLOSING, right arm: everything is packed; grasp the pull at the RIGHT end.",
     "executed": true
    },
    {
     "text": "# Slide it RIGHT -> MIDDLE to start closing the backpack.",
     "executed": true
    },
    {
     "text": "approach_best_grasp(robot, 'zipper pull', 'right', [0.0, 0.0, 0.05])",
     "executed": true
    },
    {
     "text": "robot.close_gripper('right')",
     "executed": true
    },
    {
     "text": "run_zipper_along_seam(robot, 'right', 'right end', 'middle')  # CLOSING, first half",
     "executed": true
    },
    {
     "text": "robot.open_gripper('right')",
     "executed": true
    }
   ],
   [
    {
     "text": "# STAGE 5/5 -- CLOSING, left arm: grasp the pull at the MIDDLE.",
     "executed": true
    },
    {
     "text": "# Slide it MIDDLE -> LEFT; the backpack is now fully CLOSED. Task done.",
     "executed": true
    },
    {
     "text": "approach_best_grasp(robot, 'zipper pull', 'left', [0.0, 0.0, 0.05])",
     "executed": true
    },
    {
     "text": "robot.close_gripper('left')",
     "executed": true
    },
    {
     "text": "run_zipper_along_seam(robot, 'left', 'middle', 'left end')  # CLOSING, second half",
     "executed": true
    },
    {
     "text": "robot.open_gripper('left')",
     "executed": true
    }
   ]
  ],
