 {
  "id": "fold_and_stack_towels",
  "label": "Fold and Stack Towels",
  "platform": "yam",
  "instruction": "Fold the towels and stack them in pink, brown, green order.",
  "fps": 30,
  "video": "/videos/episodes/fold_and_stack_towels.mp4",
  "figure": "/figures/tasks/fold_and_stack_towels.webp",
  "blocks": [
   [
    {
     "text": "LEFT, RIGHT, BOTH = ['left'], ['right'], ['left', 'right']",
     "executed": true
    },
    {
     "text": "# the towels start side by side: brown (left), pink (middle), green (right).",
     "executed": true
    },
    {
     "text": "# fold them in table order -- middle, right, left -- then stack them bottom-to-top",
     "executed": true
    },
    {
     "text": "# in the order the instruction names.",
     "executed": true
    },
    {
     "text": "# STAGE 1/6 FOLD PINK | folded: nothing yet | stack: empty | next: fold the green towel",
     "executed": true
    },
    {
     "text": "for arms, deltas, crease in [",
     "executed": true
    },
    {
     "text": "        (RIGHT, [[-0.12,0.13,-0.23]], False),                  # 1/4 sweep over the towel",
     "executed": true
    },
    {
     "text": "        (BOTH, [[0.21,0.05,0.03], [0.18,0.05,0.03]], False),   # 2/4 push to the far side",
     "executed": true
    },
    {
     "text": "        (RIGHT, [[0.00,0.15,0.04]], False),                    # 3/4 sweep over the towel",
     "executed": true
    },
    {
     "text": "        (RIGHT, [[0.20,0.07,0.01]], True)]:                    # 4/4 push to the far side",
     "executed": true
    },
    {
     "text": "    approach_best_grasp(robot, 'pink towel edge', arms[0], [0.0, 0.0, -0.05])",
     "executed": true
    },
    {
     "text": "    for a in arms:                  robot.grasp('pink towel', a)",
     "executed": true
    },
    {
     "text": "    for a, d in zip(arms, deltas):  robot.servo_ee_delta(a, d)   # measured travel while gripping",
     "executed": true
    },
    {
     "text": "    if crease:                      fold_over_and_crease(robot, 'pink towel')",
     "executed": true
    },
    {
     "text": "    for a in arms:                  robot.release(a)",
     "executed": true
    },
    {
     "text": "robot.freespace_move_home('right')   # the pink towel is folded; move on",
     "executed": true
    }
   ],
   [
    {
     "text": "# STAGE 2/6 FOLD GREEN | folded: pink | stack: empty | next: fold the brown towel",
     "executed": true
    },
    {
     "text": "for arms, deltas, crease in [",
     "executed": true
    },
    {
     "text": "        (RIGHT, [[-0.08,0.22,-0.10]], False),                       # 1/4 sweep over the towel",
     "executed": true
    },
    {
     "text": "        (BOTH, [[0.00,-0.03,-0.04], [-0.02,-0.05,-0.01]], False),   # 2/4 press the fold flat",
     "executed": true
    },
    {
     "text": "        (BOTH, [[0.15,0.02,0.03], [0.13,-0.03,0.02]], False),       # 3/4 push to the far side",
     "executed": true
    },
    {
     "text": "        (RIGHT, [[-0.05,0.16,0.04]], True)]:                        # 4/4 sweep over the towel",
     "executed": true
    },
    {
     "text": "    approach_best_grasp(robot, 'green towel edge', arms[0], [0.0, 0.0, -0.05])",
     "executed": true
    },
    {
     "text": "    for a in arms:                  robot.grasp('green towel', a)",
     "executed": true
    },
    {
     "text": "    for a, d in zip(arms, deltas):  robot.servo_ee_delta(a, d)   # measured travel while gripping",
     "executed": true
    },
    {
     "text": "    if crease:                      fold_over_and_crease(robot, 'green towel')",
     "executed": true
    },
    {
     "text": "    for a in arms:                  robot.release(a)",
     "executed": true
    }
   ],
   [
    {
     "text": "# STAGE 3/6 FOLD BROWN | folded: pink, green | stack: empty | next: stack them: pink, brown, green",
     "executed": true
    },
    {
     "text": "for arms, deltas, crease in [",
     "executed": true
    },
    {
     "text": "        (RIGHT, [[0.24,-0.19,0.01]], False),                        # 1/5 push to the far side",
     "executed": true
    },
    {
     "text": "        (LEFT, [[-0.22,-0.28,-0.24]], False),                       # 2/5 sweep the other way",
     "executed": true
    },
    {
     "text": "        (BOTH, [[-0.01,-0.03,-0.13], [0.01,-0.03,-0.18]], False),   # 3/5 sweep the other way",
     "executed": true
    },
    {
     "text": "        (BOTH, [[0.17,0.02,0.01], [0.17,0.02,0.01]], False),        # 4/5 push to the far side",
     "executed": true
    },
    {
     "text": "        (RIGHT, [[0.00,0.20,0.01]], True)]:                         # 5/5 sweep over the towel",
     "executed": true
    },
    {
     "text": "    approach_best_grasp(robot, 'brown towel edge', arms[0], [0.0, 0.0, -0.05])",
     "executed": true
    },
    {
     "text": "    for a in arms:                  robot.grasp('brown towel', a)",
     "executed": true
    },
    {
     "text": "    for a, d in zip(arms, deltas):  robot.servo_ee_delta(a, d)   # measured travel while gripping",
     "executed": true
    },
    {
     "text": "    if crease:                      fold_over_and_crease(robot, 'brown towel')",
     "executed": true
    },
    {
     "text": "    for a in arms:                  robot.release(a)",
     "executed": true
    }
   ],
   [
    {
     "text": "# STAGES 4-6/6 STACK | all three folded | pile them bottom-to-top as the instruction names",
     "executed": true
    },
    {
     "text": "for towel, arm, target_pos in [",
     "executed": true
    },
    {
     "text": "        ('pink towel', 'right', [0.44, -0.08, 0.77]),     # STAGE 4/6 — pile so far: empty",
     "executed": true
    },
    {
     "text": "        ('brown towel', 'left', [0.47, -0.04, 0.81]),     # STAGE 5/6 — pile so far: pink",
     "executed": true
    },
    {
     "text": "        ('green towel', 'right', [0.42, -0.09, 0.79])]:   # STAGE 6/6 — pile so far: pink, brown",
     "executed": true
    },
    {
     "text": "    robot.freespace_move_to(towel)",
     "executed": true
    },
    {
     "text": "    approach_best_grasp(robot, towel, arm, [0.0, 0.0, -0.05])",
     "executed": true
    },
    {
     "text": "    robot.grasp(towel, arm)",
     "executed": true
    },
    {
     "text": "    robot.servo_ee_delta(arm, [0.0, 0.0, 0.08])   # lift it clear of the table",
     "executed": true
    },
    {
     "text": "    stack = robot.detect_objects_oneshot('stack')",
     "executed": true
    },
    {
     "text": "    robot.freespace_move(**{arm + '_target_pos': target_pos,",
     "executed": true
    },
    {
     "text": "                            arm + '_target_rpy': state.data[arm]['ee_rpy']})",
     "executed": true
    },
    {
     "text": "    robot.servo_ee_delta(arm, [0.0, 0.0, -0.07])   # lower onto the pile",
     "executed": true
    },
    {
     "text": "    robot.release(arm)",
     "executed": true
    }
   ]
  ],
