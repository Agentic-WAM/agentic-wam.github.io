 {
  "id": "arrange_fruits_sharpa",
  "label": "Arrange Fruits with Tongs",
  "platform": "sharpa",
  "instruction": "Arrange the fruits so that there will be only pear in the left bowl.",
  "fps": 30,
  "video": "/videos/episodes/arrange_fruits_sharpa.mp4",
  "figure": "/figures/tasks/arrange_fruits_sharpa.webp",
  "blocks": [
   [
    {
     "text": "# goal: the left bowl must end up holding only the pear",
     "executed": true
    },
    {
     "text": "targets = {'pear'}",
     "executed": true
    },
    {
     "text": "tongs = robot.detect_objects_oneshot('tongs')      # on the stand at the right edge of the table",
     "executed": true
    },
    {
     "text": "robot.freespace_move('right', [+0.42, -0.44, +0.74])   # measured stand pose",
     "executed": true
    },
    {
     "text": "robot.grasp_tool('right', 'tongs')                 # the fingers wrap the handle and stay closed",
     "executed": true
    }
   ],
   [
    {
     "text": "bowl = robot.scan('left bowl')                     # sees {'apple'}",
     "executed": true
    },
    {
     "text": "robot.servo_ee_delta('right', [-0.06, +0.44, +0.00])    # lift the tongs off the stand and travel",
     "executed": true
    }
   ],
   [
    {
     "text": "robot.freespace_move('right', [+0.38, +0.00, +0.72])   # over the apple in the left bowl",
     "executed": true
    },
    {
     "text": "robot.servo_ee_delta('right', [+0.00, +0.04, -0.02])    # lower the tong tips around it",
     "executed": true
    },
    {
     "text": "robot.squeeze_tongs('right', 'apple')              # pinch until the apple is held",
     "executed": true
    }
   ],
   [
    {
     "text": "robot.servo_ee_delta('right', [+0.00, -0.12, +0.12])    # lift it over the rim",
     "executed": true
    },
